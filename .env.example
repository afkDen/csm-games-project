# Local tooling only. Copy to .env.local and keep it untracked.

# Pexels API (optional; photo/video sourcing only)
PEXELS_API_KEY=

# 21st CLI/MCP non-interactive auth (optional)
API_KEY_21ST=

# Context7 key if you choose key auth instead of OAuth/device flow (optional)
CONTEXT7_API_KEY=

# Optional provider key used by Scroll Craft asset-generation flows only if explicitly enabled.
# KIE_AI_API_KEY=

# Poly Haven public API currently does not require an API key.
